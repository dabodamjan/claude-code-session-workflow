            "modifiers": {
              "mandatory": [
                "right_option"
              ]
            }
          },
          "to": [
            {
              "key_code": "slash",
              "modifiers": []
            },
            {
              "key_code": "c",
              "modifiers": []
            },
            {
              "key_code": "o",
              "modifiers": []
            },
            {
              "key_code": "m",
              "modifiers": []
